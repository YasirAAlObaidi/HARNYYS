# Copy this file to deploy/.env and fill it in. deploy/.env is git-ignored: never commit it.
# These values are read by deploy/compose.yaml and filled into config.yaml as ${NAME}.

# Password for the Postgres user "yyai". Make one up. It is used inside a database URL, so use only
# letters and digits, for example the output of:  openssl rand -hex 24
# Postgres stores it the first time the database starts. Changing it here later does not change the database.
POSTGRES_PASSWORD=

# Which client folder to mount (config.yaml and catalogue.json), relative to deploy/.
YYAI_CLIENT_DIR=./clients/kahraman

# API key for the model endpoint named in config.yaml. For the demo this is an OpenRouter key:
# openrouter.ai > Settings > Keys > Create key.
MODEL_API_KEY=

# The next four come from the Meta app (developers.facebook.com > your app > WhatsApp).
# None of them may be empty: the server refuses to start if one is. To try the demo through the web
# chat endpoint only, type a placeholder such as "unset". Put in the real values BEFORE you turn the
# tunnel on: a made-up app secret means the webhook cannot tell real Meta calls from fakes.

# WhatsApp > API Setup > "Phone number ID". This is a long number, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp > API Setup > Access token. The one on that page expires after about 24 hours: for anything
# longer, create a System User in Meta Business Settings and generate a permanent token for this app.
WHATSAPP_ACCESS_TOKEN=

# App settings > Basic > "App secret" (click Show). Used to check that webhook calls really come from Meta.
WHATSAPP_APP_SECRET=

# Make up any random string. Type the same string into WhatsApp > Configuration > Webhook > Verify token.
WHATSAPP_VERIFY_TOKEN=

# Only needed with the "tunnel" profile. Cloudflare dashboard > Zero Trust > Networks > Tunnels >
# create a tunnel (Docker) > copy the token from the install command (the long string after --token).
CLOUDFLARE_TUNNEL_TOKEN=
