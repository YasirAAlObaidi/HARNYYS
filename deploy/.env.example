# Copy this file to deploy/.env and fill it in. deploy/.env is git-ignored: never commit it.
# These values are read by deploy/compose.yaml and filled into config.yaml as ${NAME}.

# Password for the Postgres user "yyai". Make one up. It is used inside a database URL, so use only
# letters and digits, for example the output of:  openssl rand -hex 24
# Postgres stores it the first time the database starts. Changing it here later does not change the database.
POSTGRES_PASSWORD=

# Which client folder to mount (config.yaml and catalogue.json), relative to deploy/.
YYAI_CLIENT_DIR=./clients/kahraman

# Which model answers customers. config.yaml reads these four. Leave MODEL_BASE_URL, MODEL_NAME,
# MODEL_EXTERNAL and MODEL_ALLOW_EXTERNAL out and you get the hosted Qwen on OpenRouter (the demo default).
# Use ONE of the two blocks below.
#
# MODEL_EXTERNAL says the endpoint is outside the client's building. MODEL_ALLOW_EXTERNAL is the switch
# that permits sending data there: set it to true only when the client has agreed in writing.

# --- Option A: a local model on this Mac (llama.cpp / llama-server on port 8080) ---
# To use it, uncomment these five lines and comment out Option B.
# host.docker.internal is the Mac as seen from inside the containers (works with Colima and Docker
# Desktop; on a Linux host also uncomment extra_hosts on the worker in compose.yaml). MODEL_NAME is the
# alias llama-server serves. MODEL_API_KEY can be any non-empty text: llama-server does not check it.
# MODEL_BASE_URL=http://host.docker.internal:8080/v1
# MODEL_NAME=ling-3.0-tiny
# MODEL_EXTERNAL=false
# MODEL_ALLOW_EXTERNAL=false
# MODEL_API_KEY=local

# --- Option B: Qwen on OpenRouter (DEMO ONLY: data leaves the building) ---
# These are also what you get when the four MODEL_* lines are left out. Only the key is needed.
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=qwen/qwen3.8-27b
# MODEL_EXTERNAL=true
# MODEL_ALLOW_EXTERNAL=true
# openrouter.ai > Settings > Keys > Create key.
MODEL_API_KEY=

# The next four come from the Meta app (developers.facebook.com > your app > WhatsApp).
# None of them may be empty: the server refuses to start if one is. To try the demo through the web
# chat endpoint only, type a placeholder such as "unset". Put in the real values BEFORE you turn the
# tunnel on: a made-up app secret means the webhook cannot tell real Meta calls from fakes.

# WhatsApp > API Setup > "Phone number ID". This is a long number, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp > API Setup > Access token. The one on that page expires after about 24 hours: for anything
# longer, create a System User in Meta Business Settings and generate a permanent token for this app.
WHATSAPP_ACCESS_TOKEN=

# App settings > Basic > "App secret" (click Show). Used to check that webhook calls really come from Meta.
WHATSAPP_APP_SECRET=

# Make up any random string. Type the same string into WhatsApp > Configuration > Webhook > Verify token.
WHATSAPP_VERIFY_TOKEN=

# Only needed with the "tunnel" profile. Cloudflare dashboard > Zero Trust > Networks > Tunnels >
# create a tunnel (Docker) > copy the token from the install command (the long string after --token).
CLOUDFLARE_TUNNEL_TOKEN=

# --- The staff web app (Caddy). Leave these five out to test on this machine at http://localhost:8080 ---
# Where Caddy answers. On a client box: their subdomain, for example kahraman.<our domain>.
# YYAI_SITE=http://:8080
# none (plain HTTP, this machine only), internal (Caddy's own certificate: browsers warn) or dns (production).
# YYAI_TLS=none
# PLACEHOLDER until Kahraman's subdomain and DNS provider are known. Needs a Caddy build with that provider's
# module (apps/web/Dockerfile). The token may only edit the one DNS zone.
# YYAI_DNS_PROVIDER=
# YYAI_DNS_API_TOKEN=
# Which host address and port Caddy is published on. The defaults are this machine only. On a client box,
# publish HTTPS to the office network, for example YYAI_HTTPS_BIND=443 (or 192.168.1.10:443).
# YYAI_HTTP_BIND=127.0.0.1:8080
# YYAI_HTTPS_BIND=127.0.0.1:8443
